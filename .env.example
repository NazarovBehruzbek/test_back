# Application
APP_NAME="AqlliOlam VMS"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
TIMEZONE="Asia/Tashkent"

# Database (PostgreSQL + asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aqlliolam_vms"
DB_ECHO=false

# Docker Compose PostgreSQL sozlamalari (ixtiyoriy)
POSTGRES_DB="aqlliolam_vms"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5432

# Security (kamida 32 belgili tasodifiy kalit qo'ying)
SECRET_KEY="replace-with-a-strong-random-secret-key-at-least-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
